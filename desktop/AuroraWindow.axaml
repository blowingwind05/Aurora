<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Aurora.AuroraWindow" Title="Aurora 远程桌面"
        Width="1000" Height="720" MinWidth="730" MinHeight="600"
        Background="#F5F5F1" Foreground="#182842"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14"
        WindowStartupLocation="CenterScreen" SystemDecorations="Full">
  <Grid RowDefinitions="54,*">
    <Grid Margin="16,4,9,0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
      <Border x:Name="DragArea" Grid.ColumnSpan="2" Background="Transparent" />
      <StackPanel x:Name="CaptionButtons" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="MinimizeWindow" Classes="caption" AutomationProperties.Name="最小化" ToolTip.Tip="最小化">
          <Path Data="M0,5 L10,5" Stroke="#273858" StrokeThickness="1" />
        </Button>
        <Button x:Name="MaximizeWindow" Classes="caption" AutomationProperties.Name="最大化" ToolTip.Tip="最大化">
          <Path x:Name="MaximizeIcon" Data="M0,0 L10,0 L10,10 L0,10 Z" Stroke="#273858" StrokeThickness="1" />
        </Button>
        <Button x:Name="CloseWindow" Classes="caption close" AutomationProperties.Name="关闭" ToolTip.Tip="关闭">
          <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="#273858" StrokeThickness="1" />
        </Button>
      </StackPanel>
      <Border x:Name="TitleIcon" Width="16" Height="16" CornerRadius="4" Background="#244FC5" VerticalAlignment="Center" IsHitTestVisible="False">
        <Path Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
              Fill="White" Data="M 12,0 L 14.8,8.7 L 24,12 L 14.8,15.3 L 12,24 L 9.2,15.3 L 0,12 L 9.2,8.7 Z" />
      </Border>
      <TextBlock Grid.Column="1" Text="Aurora 远程桌面" FontSize="14" FontWeight="Normal"
                 VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis" />
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="156,*">
      <Border Background="#EDF0F6" BorderBrush="#DCE1EC" BorderThickness="0,0,1,0" Padding="10,14">
        <ListBox x:Name="Navigation" Classes="navigation" Background="Transparent" SelectedIndex="0" AutomationProperties.Name="主导航">
          <ListBoxItem Content="我的设备" />
          <ListBoxItem x:Name="HostNavItem" Content="本机被控" />
          <ListBoxItem Content="异地连接" />
        </ListBox>
      </Border>
      <Grid Grid.Column="1" Margin="18,14,18,16" RowDefinitions="*,Auto" RowSpacing="10">
        <Grid x:Name="HostPage" RowDefinitions="Auto,*" IsVisible="False">
    <Border x:Name="HostSummary" Margin="0,0,0,10" CornerRadius="16" BorderThickness="1" BorderBrush="#CFDAF3" Padding="21,16">
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Color="#E7EFFF" Offset="0" />
          <GradientStop Color="#F4F4FF" Offset="1" />
        </LinearGradientBrush>
      </Border.Background>
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <StackPanel Spacing="6">
          <TextBlock x:Name="HostBadge" Text="这台电脑 · 正在检查" FontSize="12" FontWeight="SemiBold" Foreground="#304FA1" />
          <TextBlock x:Name="HostTitle" Text="让其他设备连接这台电脑" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock x:Name="HostHint" Text="正在检查本机被控状态…" Classes="muted" TextWrapping="Wrap" />
          <TextBlock x:Name="LocalAddress" Text="正在获取本机地址…" FontSize="13" Foreground="#354A72" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center" MinWidth="155">
          <Button x:Name="HostAction" Classes="action accent" HorizontalAlignment="Stretch" Content="启用本机被控" IsEnabled="False" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button x:Name="CopyAddress" Classes="action" Content="复制局域网" IsEnabled="False" />
            <Button x:Name="CopyTailnet" Classes="action" Content="复制 Tailscale" IsEnabled="False" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>
          <ContentControl x:Name="HostSettings" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </Grid>

    <Border x:Name="DevicesPage" Padding="17,13" CornerRadius="15" BorderThickness="1" BorderBrush="#DCE1EC" Background="#FFFFFF">
      <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="9">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <StackPanel Spacing="3">
            <TextBlock Text="我的设备" FontSize="21" FontWeight="SemiBold" />
            <TextBlock x:Name="DeviceSummary" Text="正在发现同账号设备…" Classes="muted" FontSize="13" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <Button x:Name="Refresh" Grid.Column="1" Classes="action" Content="刷新" VerticalAlignment="Center" />
        </Grid>
        <Grid Grid.Row="1" MinHeight="85">
          <ListBox x:Name="Devices" Background="Transparent" />
          <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="7" MaxWidth="475" Margin="14,8">
            <TextBlock x:Name="EmptyTitle" Text="正在寻找设备" FontSize="17" FontWeight="SemiBold" TextAlignment="Center" />
            <TextBlock x:Name="EmptyHint" Text="正在检查局域网和 Tailscale。" Classes="muted" TextWrapping="Wrap" TextAlignment="Center" />
          </StackPanel>
        </Grid>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBlock x:Name="SelectionHint" Text="选择在线 Windows 设备后可连接" Classes="muted"
                     FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <Button x:Name="Connect" Grid.Column="1" Classes="action accent" Content="连接桌面" IsEnabled="False" />
        </Grid>
        <Grid x:Name="NetworkNotice" Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="10" IsVisible="False">
          <TextBlock x:Name="NetworkMessage" Classes="muted" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
          <Button x:Name="NetworkHelp" Grid.Column="1" Content="设置异地连接" FontSize="12"
                  Classes="action" MinHeight="30" Padding="10,4" VerticalAlignment="Center" />
        </Grid>
      </Grid>
    </Border>
        <ContentControl x:Name="TailnetPage" IsVisible="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        <TextBlock x:Name="Feedback" Grid.Row="1" Classes="muted" FontSize="12" Text="设备列表每 10 秒自动刷新。" TextTrimming="CharacterEllipsis" />
      </Grid>
    </Grid>
  </Grid>
</Window>
