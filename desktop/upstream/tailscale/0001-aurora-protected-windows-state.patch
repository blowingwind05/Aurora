@@ -0,0 +1,7 @@
+// SPDX-License-Identifier: BSD-3-Clause
+
+// Package auroradata locates Aurora's protected Windows machine data directory.
+package auroradata
+
+// WindowsMachineDataDir returns the machine data directory of the Aurora build.
+var WindowsMachineDataDir = func() string { panic("Windows machine data requested on a non-Windows platform") }
--- /dev/null
+++ b/auroradata/dir_windows.go
@@ -0,0 +1,20 @@
+// SPDX-License-Identifier: BSD-3-Clause
+
+package auroradata
+
+import (
+	"path/filepath"
+	"sync"
+
+	"golang.org/x/sys/windows"
+)
+
+func init() {
+	WindowsMachineDataDir = sync.OnceValue(func() string {
+		root, err := windows.KnownFolderPath(windows.FOLDERID_ProgramFiles, 0)
+		if err != nil || !filepath.IsAbs(root) || len(filepath.VolumeName(root)) != 2 {
+			panic("cannot locate the local Windows Program Files directory")
+		}
+		return filepath.Join(root, "AuroraTailnet", "Tailscale")
+	})
+}
