Subject: [PATCH] Restrict the Aurora stream target to private runtime commands
Apply after 0001-aurora-background-pair.patch.

diff --git a/app/main.cpp b/app/main.cpp
--- a/app/main.cpp
+++ b/app/main.cpp
@@ -13,6 +13,10 @@
 #include <QRegularExpression>
 #include <QTimer>
 
+#ifdef AURORA_STREAM_RUNTIME
+#include "AuroraStreamEntry.h"
+#endif
+
 // Don't let SDL hook our main function, since Qt is already
 // doing the same thing. This needs to be before any headers
 // that might include SDL.h themselves.
@@ -286,5 +290,11 @@
 int main(int argc, char *argv[])
 {
+#ifdef AURORA_STREAM_RUNTIME
+    const int invocation = prepareAuroraStreamInvocation(argc, argv);
+    if (invocation >= 0) {
+        return invocation;
+    }
+#endif
     SDL_SetMainReady();
 
     // Set the app version for the QCommandLineParser's showVersion() command
