Subject: [PATCH] Respect cursor visibility in the Aurora video child window

diff --git a/app/streaming/auroraembedded.h b/app/streaming/auroraembedded.h
--- a/app/streaming/auroraembedded.h
+++ b/app/streaming/auroraembedded.h
@@ -170,6 +170,13 @@
     static LRESULT CALLBACK focusOnClick(HWND hwnd, UINT message, WPARAM wParam, LPARAM lParam)
     {
         switch (message) {
+        case WM_SETCURSOR:
+            // A foreign HWND can otherwise restore its Win32 class cursor after SDL hides it.
+            if (LOWORD(lParam) == HTCLIENT && SDL_ShowCursor(SDL_QUERY) == SDL_DISABLE) {
+                SetCursor(nullptr);
+                return TRUE;
+            }
+            break;
         case WM_LBUTTONDOWN:
         case WM_RBUTTONDOWN:
         case WM_MBUTTONDOWN:
diff --git a/app/streaming/session.cpp b/app/streaming/session.cpp
--- a/app/streaming/session.cpp
+++ b/app/streaming/session.cpp
@@ -1865,8 +1865,9 @@
         // Native Wayland: Capture on SDL_WINDOWEVENT_ENTER
         needsFirstEnterCapture = true;
     }
-    else if (!isEmbedded) {
-        // X11/XWayland: Capture after decoder creation
+    else if (!isEmbedded || m_Preferences->absoluteMouseMode) {
+        // Embedded desktop mode tracks the pointer immediately without locking it.
+        // X11/XWayland also activate after decoder creation.
         needsPostDecoderCreationCapture = true;
     }
 
diff --git a/app/streaming/input/input.cpp b/app/streaming/input/input.cpp
--- a/app/streaming/input/input.cpp
+++ b/app/streaming/input/input.cpp
@@ -396,6 +396,9 @@
                 motionEvent.y = mouseY;
                 handleMouseMotionEvent(&motionEvent);
             }
+            else {
+                SDL_ShowCursor(SDL_ENABLE);
+            }
         }
     }
     else {
