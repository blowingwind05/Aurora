Subject: [PATCH] Publish measured connection details outside the video overlay

diff --git a/app/streaming/aurora-connection-details.h b/app/streaming/aurora-connection-details.h
new file mode 100644
--- /dev/null
+++ b/app/streaming/aurora-connection-details.h
@@ -0,0 +1,66 @@
+#pragma once
+
+#include <mutex>
+#include <cstdio>
+
+struct AuroraConnectionDetails {
+    int width = 0;
+    int height = 0;
+    int codec = 0;
+    int fpsHundredths = 0;
+    int videoKbps = 0;
+    int lossHundredths = -1;
+    int decodeMicroseconds = -1;
+    int roundTripMs = 0;
+    bool poor = false;
+};
+
+class AuroraConnectionMonitor {
+public:
+    static AuroraConnectionMonitor& instance()
+    {
+        static AuroraConnectionMonitor monitor;
+        return monitor;
+    }
+
+    void setPoor(bool poor)
+    {
+        std::lock_guard<std::mutex> guard(m_Lock);
+        m_Latest.poor = poor;
+    }
+
+    void publish(AuroraConnectionDetails details)
+    {
+        {
+            std::lock_guard<std::mutex> guard(m_Lock);
+            details.poor = m_Latest.poor;
+            m_Latest = details;
+        }
+#ifdef Q_OS_WIN32
+        if (m_WriteToParent) {
+            std::fprintf(stdout, "aurora-connection/1,%d,%d,%d,%d,%d,%d,%d,%d,%d\n",
+                         details.width, details.height, details.codec, details.fpsHundredths,
+                         details.videoKbps, details.lossHundredths, details.decodeMicroseconds,
+                         details.roundTripMs, details.poor ? 1 : 0);
+            std::fflush(stdout);
+        }
+#endif
+    }
+
+    AuroraConnectionDetails latest()
+    {
+        std::lock_guard<std::mutex> guard(m_Lock);
+        return m_Latest;
+    }
+
+#ifdef Q_OS_WIN32
+    void enableParentReporting() { m_WriteToParent = true; }
+#endif
+
+private:
+    std::mutex m_Lock;
+    AuroraConnectionDetails m_Latest;
+#ifdef Q_OS_WIN32
+    bool m_WriteToParent = false;
+#endif
+};
diff --git a/app/streaming/video/decoder.h b/app/streaming/video/decoder.h
--- a/app/streaming/video/decoder.h
+++ b/app/streaming/video/decoder.h
@@ -19,6 +19,9 @@
     uint16_t maxHostProcessingLatency;
     uint32_t totalHostProcessingLatency;
     uint32_t framesWithHostProcessingLatency;
+#ifdef AURORA_STREAM_RUNTIME
+    uint64_t auroraReceivedVideoBytes;
+#endif
     uint32_t totalReassemblyTime;
     uint32_t totalDecodeTime;
     uint32_t totalPacerTime;
diff --git a/app/streaming/video/ffmpeg.cpp b/app/streaming/video/ffmpeg.cpp
--- a/app/streaming/video/ffmpeg.cpp
+++ b/app/streaming/video/ffmpeg.cpp
@@ -1,4 +1,7 @@
 #include <Limelight.h>
+#ifdef AURORA_STREAM_RUNTIME
+#include "streaming/aurora-connection-details.h"
+#endif
 #include "ffmpeg.h"
 #include "streaming/streamutils.h"
 #include "streaming/session.h"
@@ -1606,6 +1609,31 @@
 
     // Flip stats windows roughly every second
     if (SDL_TICKS_PASSED(SDL_GetTicks(), m_ActiveWndVideoStats.measurementStartTimestamp + 1000)) {
+#ifdef AURORA_STREAM_RUNTIME
+        const auto& stats = m_ActiveWndVideoStats;
+        const Uint32 elapsedMs = SDL_GetTicks() - stats.measurementStartTimestamp;
+        if (stats.receivedFrames && elapsedMs) {
+            AuroraConnectionDetails details;
+            if (m_VideoDecoderCtx) {
+                details.width = m_VideoDecoderCtx->width;
+                details.height = m_VideoDecoderCtx->height;
+            }
+            details.codec = (m_VideoFormat & VIDEO_FORMAT_MASK_H264) ? 1 :
+                            (m_VideoFormat & VIDEO_FORMAT_MASK_H265) ? 2 :
+                            (m_VideoFormat & VIDEO_FORMAT_MASK_AV1) ? 3 : 0;
+            details.fpsHundredths = static_cast<int>(stats.receivedFrames * 100000.0 / elapsedMs);
+            details.videoKbps = static_cast<int>(stats.auroraReceivedVideoBytes * 8 / elapsedMs);
+            if (stats.totalFrames) {
+                details.lossHundredths = static_cast<int>(stats.networkDroppedFrames * 10000.0 / stats.totalFrames);
+            }
+            if (stats.decodedFrames) {
+                details.decodeMicroseconds = static_cast<int>(stats.totalDecodeTime * 1000.0 / stats.decodedFrames);
+            }
+            uint32_t rtt, variance;
+            if (LiGetEstimatedRttInfo(&rtt, &variance)) details.roundTripMs = static_cast<int>(rtt);
+            AuroraConnectionMonitor::instance().publish(details);
+        }
+#endif
         // Update overlay stats if it's enabled
         if (Session::get()->getOverlayManager().isOverlayEnabled(Overlay::OverlayDebug)) {
             VIDEO_STATS lastTwoWndStats = {};
@@ -1639,6 +1667,9 @@
     m_ActiveWndVideoStats.maxHostProcessingLatency = qMax(m_ActiveWndVideoStats.maxHostProcessingLatency, du->frameHostProcessingLatency);
     m_ActiveWndVideoStats.totalHostProcessingLatency += du->frameHostProcessingLatency;
 
+#ifdef AURORA_STREAM_RUNTIME
+    if (du->fullLength > 0) m_ActiveWndVideoStats.auroraReceivedVideoBytes += du->fullLength;
+#endif
     m_ActiveWndVideoStats.receivedFrames++;
     m_ActiveWndVideoStats.totalFrames++;
 
diff --git a/app/streaming/session.cpp b/app/streaming/session.cpp
--- a/app/streaming/session.cpp
+++ b/app/streaming/session.cpp
@@ -1,4 +1,7 @@
 #include "session.h"
+#ifdef AURORA_STREAM_RUNTIME
+#include "aurora-connection-details.h"
+#endif
 #include "settings/streamingpreferences.h"
 #include "streaming/streamutils.h"
 #include "backend/richpresencemanager.h"
@@ -180,6 +183,11 @@
 
 void Session::clConnectionStatusUpdate(int connectionStatus)
 {
+#ifdef AURORA_STREAM_RUNTIME
+    if (connectionStatus == CONN_STATUS_POOR || connectionStatus == CONN_STATUS_OKAY) {
+        AuroraConnectionMonitor::instance().setPoor(connectionStatus == CONN_STATUS_POOR);
+    }
+#endif
     SDL_LogInfo(SDL_LOG_CATEGORY_APPLICATION,
                 "Connection status update: %d",
                 connectionStatus);
