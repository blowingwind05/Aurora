+  namespace {
+    constexpr auto curtain_class = L"AuroraPrivacyCurtain";
+
+    bool curtain_dwm_ready() {
+      BOOL active = FALSE;
+      return SUCCEEDED(DwmIsCompositionEnabled(&active)) && active;
