<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="using:Avalonia.Data.Converters"
             xmlns:local="using:Aurora"
             x:Class="Aurora.SunshinePage">
  <UserControl.Styles>
    <Style Selector="Grid.formRow">
      <Setter Property="MinHeight" Value="45" />
      <Setter Property="ColumnSpacing" Value="10" />
    </Style>
    <Style Selector="Grid.settingGroupHeader">
      <Setter Property="MinHeight" Value="46" />
      <Setter Property="ColumnSpacing" Value="10" />
    </Style>
  </UserControl.Styles>

  <Grid>
    <ScrollViewer x:Name="Overview" Margin="-5,0,0,0" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="5,0,8,0" Spacing="12">
        <Border x:Name="AccountPanel" Classes="panel" IsVisible="False" Padding="14">
          <StackPanel Spacing="9">
            <TextBlock x:Name="AccountTitle" Classes="sectionTitle" />
            <TextBlock x:Name="Subtitle" Text="正在检查本机 Sunshine…" Classes="muted" TextWrapping="Wrap" />
            <TextBox x:Name="Username" Watermark="Sunshine 管理用户名" AutomationProperties.Name="管理用户名" />
            <TextBox x:Name="Password" Watermark="Sunshine 管理密码" AutomationProperties.Name="管理密码" PasswordChar="●" IsUndoEnabled="False" />
            <TextBox x:Name="Confirmation" Watermark="再次输入密码" AutomationProperties.Name="确认密码" PasswordChar="●" IsUndoEnabled="False" />
            <CheckBox x:Name="RememberLogin" Content="记住登录（保存在 Windows 凭据管理器）" IsChecked="False" />
            <Button x:Name="AccountAction" Classes="action accent" />
          </StackPanel>
        </Border>

        <Border x:Name="SettingsPanel" Classes="panel settingsGroup" IsVisible="False">
          <StackPanel>
            <Grid Classes="settingGroupHeader" ColumnDefinitions="*,Auto">
              <TextBlock x:Name="CommonHeading" Text="常用设置" Classes="sectionTitle" />
              <Button x:Name="DetailedSettings" Grid.Column="1" Classes="quietAction" VerticalAlignment="Center" />
            </Grid>
            <Grid Classes="formRow">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" MaxWidth="235" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="被控电脑显示名" Classes="settingLabel" />
              <TextBox x:Name="HostName" Classes="settingField" Grid.Column="1" Watermark="系统名称" AutomationProperties.Name="被控电脑显示名" VerticalAlignment="Center" />
            </Grid>
            <Grid Classes="formRow" ColumnDefinitions="*,Auto">
              <TextBlock Text="将本机声音发送到主控端" Classes="settingLabel" />
              <ToggleSwitch x:Name="StreamAudio" Classes="settingSwitch" Grid.Column="1"
                            AutomationProperties.Name="将本机声音发送到主控端" />
            </Grid>
            <Grid Classes="formRow">
              <Button x:Name="Restart" Classes="action" Content="重启 Sunshine" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
          </StackPanel>
        </Border>

        <Border x:Name="PrivacySettings" Classes="panel settingsGroup" IsVisible="False">
          <StackPanel>
            <Grid Classes="settingGroupHeader" ColumnDefinitions="*,Auto">
              <TextBlock x:Name="DisplayHeading" Text="隐私保护" Classes="sectionTitle" />
            </Grid>
            <Grid x:Name="PrivacyScreensaverRow" Classes="formRow" ColumnDefinitions="*,Auto">
              <TextBlock Text="旧版自动隐私屏保" Classes="settingLabel" />
              <ToggleSwitch x:Name="PrivacyScreensaver" Grid.Column="1" Classes="settingSwitch"
                            AutomationProperties.Name="旧版自动隐私屏保" />
            </Grid>
            <Grid x:Name="PrivacyDisplayRow" Classes="formRow" ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" MaxWidth="235" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="远控画面来源" Classes="settingLabel" TextWrapping="Wrap" />
              <ComboBox x:Name="PrivacyDisplay" Grid.Column="1" Classes="settingField"
                        VerticalAlignment="Center" AutomationProperties.Name="远控画面来源" />
            </Grid>
            <Grid x:Name="LocalDisplaysRow" Classes="formRow" ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" MaxWidth="235" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="远控时的本地显示器" Classes="settingLabel" TextWrapping="Wrap" />
              <ComboBox x:Name="LocalDisplays" Grid.Column="1" Classes="settingField" SelectedIndex="0"
                        VerticalAlignment="Center" AutomationProperties.Name="远控时的本地显示器">
                <ComboBoxItem Content="保留本地显示器" />
                <ComboBoxItem Content="关闭所有本地显示器" />
              </ComboBox>
            </Grid>
            <TextBlock x:Name="PrivacyNote" Classes="muted" FontSize="12" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border x:Name="RestartConfirmation" Classes="panel" IsVisible="False" Padding="14,9">
          <StackPanel Spacing="8">
            <TextBlock Text="重启 Sunshine 会断开正在进行的会话。" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Button x:Name="CancelRestart" Classes="action" Content="取消" />
              <Button x:Name="ConfirmRestart" Classes="action accent" Content="确认重启" />
            </StackPanel>
          </StackPanel>
        </Border>

        <TextBlock x:Name="Feedback" IsVisible="{Binding Text, RelativeSource={RelativeSource Self}, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}" Classes="muted" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        <TextBlock x:Name="PairingFeedback" IsVisible="{Binding Text, RelativeSource={RelativeSource Self}, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}" Classes="muted" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        <Button x:Name="PairingReauthorize" Classes="action" Content="允许当前账号的设备连接" IsVisible="False" />
        <Border x:Name="MoonlightPairing" Classes="panel settingsGroup" IsVisible="False">
          <StackPanel Spacing="8">
            <TextBlock Text="Moonlight 配对请求" Classes="sectionTitle" />
            <ComboBox x:Name="MoonlightRequest" Classes="settingField" HorizontalAlignment="Stretch"
                      AutomationProperties.Name="要确认的 Moonlight 设备" />
            <TextBox x:Name="MoonlightPin" Classes="settingField" MaxLength="4" Watermark="Moonlight 显示的四位 PIN"
                     AutomationProperties.Name="Moonlight 配对 PIN" IsUndoEnabled="False" />
            <Button x:Name="ApproveMoonlight" Classes="action accent" Content="确认配对" HorizontalAlignment="Right" />
          </StackPanel>
        </Border>
        <StackPanel Spacing="5">
          <TextBlock x:Name="ConnectionNote" Classes="muted" TextWrapping="Wrap" />
          <TextBlock x:Name="MacPermissionNote" Classes="muted" TextWrapping="Wrap" IsVisible="False"
                     Text="首次被控需要在 macOS 隐私设置中允许 Aurora Host 录制屏幕和使用辅助功能。授权后可重启被控组件。" />
          <Button x:Name="ImportCert" Classes="action accent" Content="导入公开证书指纹" IsVisible="False" />
          <WrapPanel Margin="-5,0,0,0" ItemSpacing="8" LineSpacing="2">
            <Button x:Name="MacPermissions" Classes="quietAction" Content="打开 macOS 隐私设置" IsVisible="False" />
            <Button x:Name="OriginalPage" Classes="quietAction" Content="打开 Sunshine 原版设置" IsVisible="False" />
            <Button x:Name="ForgetLogin" Classes="quietAction" Content="忘记已保存的登录" IsVisible="False" />
          </WrapPanel>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <ContentControl x:Name="Options" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsVisible="False" />

  </Grid>
</UserControl>
